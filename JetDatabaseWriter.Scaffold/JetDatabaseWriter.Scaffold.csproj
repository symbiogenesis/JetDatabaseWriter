<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JetDatabaseWriter.Scaffold</RootNamespace>
    <AssemblyName>JetDatabaseWriter.Scaffold</AssemblyName>
    <!-- Run with dotnet run (see the README); it is not published as a package or tool. -->
    <IsPackable>false</IsPackable>
    <!-- CA1303: literal strings are fine in a CLI tool; CA1849: sync Console is fine for a CLI -->
    <NoWarn>$(NoWarn);CA1303;CA1849</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JetDatabaseWriter.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JetDatabaseWriter\JetDatabaseWriter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>

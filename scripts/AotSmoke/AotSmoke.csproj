<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NuGetLockFilePath>packages.$(SmokeMode).lock.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(SmokeMode)' == 'seed'">$(DefineConstants);SEED</DefineConstants>
    <IsPackable>false</IsPackable>
    <PublishTrimmed Condition="'$(SmokeMode)' == 'trimmed'">true</PublishTrimmed>
    <PublishAot Condition="'$(SmokeMode)' == 'native'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Remove="@(AdditionalFiles)" />
    <AdditionalFiles Include="../../BannedSymbols.txt" />
    <AdditionalFiles Include="../../stylecop.json" />
    <ProjectReference Include="../../JetDatabaseWriter/JetDatabaseWriter.csproj" />
    <Compile Include="$(GeneratedModels)/*.cs" Condition="'$(GeneratedModels)' != ''" />
  </ItemGroup>
</Project>

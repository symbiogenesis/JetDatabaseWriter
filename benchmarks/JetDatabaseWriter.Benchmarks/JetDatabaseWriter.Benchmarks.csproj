<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- BenchmarkDotNet requires public types and underscore-named methods are idiomatic -->
        <NoWarn>$(NoWarn);CA1515;CA1707;CA1034;CA1822</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\JetDatabaseWriter\JetDatabaseWriter.csproj" />
        <ProjectReference Include="..\..\tests\JetDatabaseWriter.TestSupport\JetDatabaseWriter.TestSupport.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\tests\JetDatabaseWriter.Tests\Databases\Encrypted\NativeAceAgile.accdb" Link="NativeAceAgile.accdb">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\..\tests\JetDatabaseWriter.Tests\Databases\NorthwindTraders.accdb" Link="NorthwindTraders.accdb">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <PackageId>JetDatabaseWriter</PackageId>
    <Authors>Diego Ripera, Edward Miller</Authors>
    <Company>Ripera</Company>
    <Description>Managed database reader and writer for Microsoft Access JET databases (.mdb/.accdb). No OleDB, ODBC, or ACE drivers required.</Description>
    <PackageTags>access;jet;mdb;accdb;database;microsoft-access</PackageTags>
    <PackageProjectUrl>https://github.com/symbiogenesis/JetDatabaseWriter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/symbiogenesis/JetDatabaseWriter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/symbiogenesis/JetDatabaseWriter/releases</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- No .snupkg: DotNet.ReproducibleBuilds embeds the PDB in the DLL, so it would be empty. -->
    <!--
      MinVer sets the version from the latest vX.Y.Z tag reachable from HEAD: a tagged
      commit packs as X.Y.Z and any later commit as a prerelease of the next patch.
      With no 4.x tag yet, untagged builds are 4.0.0-alpha.0.<height>. See PUBLISH.md.
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>4.0</MinVerMinimumMajorMinor>
    <!--
      Checks on every pack that each public API of the netstandard2.1 build also exists in
      the net10.0 build. A PackageValidationBaselineVersion is added once a version is on
      nuget.org (see PUBLISH.md).
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JetDatabaseWriter.Tests" />
    <InternalsVisibleTo Include="JetDatabaseWriter.Benchmarks" />
    <InternalsVisibleTo Include="JetDatabaseWriter.FormatProbe" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!--
    Per-codepoint General Legacy text-index sort-key tables, sourced verbatim from
    Apache Jackcess (Apache License 2.0). Stored gzipped to keep the assembly small;
    decompressed on first use. See THIRD-PARTY-NOTICES.md.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Indexes\CodeTables\index_codes_genleg.txt.gz" LogicalName="JetDatabaseWriter.IndexCodeTables.index_codes_genleg.txt.gz" />
    <EmbeddedResource Include="Indexes\CodeTables\index_codes_ext_genleg.txt.gz" LogicalName="JetDatabaseWriter.IndexCodeTables.index_codes_ext_genleg.txt.gz" />
    <EmbeddedResource Include="Indexes\CodeTables\index_codes_gen.txt.gz" LogicalName="JetDatabaseWriter.IndexCodeTables.index_codes_gen.txt.gz" />
    <EmbeddedResource Include="Indexes\CodeTables\index_codes_ext_gen.txt.gz" LogicalName="JetDatabaseWriter.IndexCodeTables.index_codes_ext_gen.txt.gz" />
    <EmbeddedResource Include="Indexes\CodeTables\index_codes_gen_97.txt.gz" LogicalName="JetDatabaseWriter.IndexCodeTables.index_codes_gen_97.txt.gz" />
    <EmbeddedResource Include="Indexes\CodeTables\index_mappings_ext_gen_97.txt.gz" LogicalName="JetDatabaseWriter.IndexCodeTables.index_mappings_ext_gen_97.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML.Parser" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    System.Linq.AsyncEnumerable (Where/ToListAsync/etc. over IAsyncEnumerable<T>) ships in the
    BCL on .NET 10+. For older consumers (anything resolving the netstandard2.1 asset), pull in
    System.Linq.Async transitively so the async LINQ surface in our public API "just works"
    without requiring downstream projects to add the package themselves.
    The System.ComponentModel.DataAnnotations.Schema attributes the POCO mapping model honors
    ([Column], [NotMapped], and [Table]) are likewise in-box on .NET 10+ but live in
    System.ComponentModel.Annotations for netstandard2.1.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Linq.Async" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>
</Project>

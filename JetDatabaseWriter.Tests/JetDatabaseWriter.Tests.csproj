<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Tests run on .NET 10 locally. CI also executes these binaries on .NET 11.
      TestNetStandard selects the library's netstandard2.1 asset in a separate lane.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>JetDatabaseWriter.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;SA1615</NoWarn>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAnalyzersDuringBuild Condition="'$(Configuration)' != 'Release'">false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild Condition="'$(Configuration)' != 'Release'">false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile Condition="'$(Configuration)' != 'Release'">false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TestNetStandard)' == 'true'">
    <NuGetLockFilePath>packages.netstandard.lock.json</NuGetLockFilePath>
    <DefineConstants>$(DefineConstants);TEST_NETSTANDARD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JetDatabaseWriter\JetDatabaseWriter.csproj" />
    <ProjectReference Include="..\JetDatabaseWriter.TestSupport\JetDatabaseWriter.TestSupport.csproj" />
  </ItemGroup>

  <!--
    Scaffolding references the native library asset. Exclude its tests from the
    standard-asset lane so the runner cannot load a mixture of library builds.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' and '$(TestNetStandard)' != 'true'">
    <ProjectReference Include="..\JetDatabaseWriter.Scaffold\JetDatabaseWriter.Scaffold.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0' or '$(TestNetStandard)' == 'true'">
    <Compile Remove="Scaffold\EntityEmitterIdentifierTests.cs" />
    <Compile Remove="Scaffold\EntityEmitterNavigationTests.cs" />
    <Compile Remove="Scaffold\EntityEmitterTests.cs" />
    <Compile Remove="Scaffold\NameCleanerTests.cs" />
    <Compile Remove="Scaffold\NavigationResolverTests.cs" />
    <Compile Remove="Scaffold\ScaffoldCompilation.cs" />
    <Compile Remove="Scaffold\ScaffoldedEntityColumnMappingTests.cs" />
    <Compile Remove="Scaffold\ScaffoldNamesTests.cs" />
    <Compile Remove="Scaffold\ScaffoldRunnerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Databases\**\*.mdw;Databases\**\*.mdb;Databases\**\*.accdb;Databases\**\*.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Databases\Golden\*.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Databases\NativeText\*.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Cfb\**\*.cfs;Cfb\**\*.doc;Cfb\**\*.xls;Cfb\**\*.ppt;Cfb\**\*.suo" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
